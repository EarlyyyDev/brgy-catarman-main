
NODE_ENV=development
PORT=5000
CORS_ORIGIN=http://localhost:3000
FRONTEND_URL=http://localhost:3000

BCRYPT_SALT_ROUNDS=12

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional failover pool. Use keys from separately authorized Gemini projects;
# keys in the same project share its quota. GEMINI_API_KEY remains supported.
GEMINI_API_KEYS=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
